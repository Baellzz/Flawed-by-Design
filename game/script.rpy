# --- Объявление фонов и лого (с авто-растяжением на весь экран) ---
image bg black_corridor = Transform("images/backgrounds/black_corridor.png", xysize=(1920, 1080))
image bg home_corridor = Transform("images/backgrounds/home_corridor.png", xysize=(1920, 1080))
image bg table_closed = Transform("images/backgrounds/tabble_closed_letter.png", xysize=(1920, 1080))
image bg table_open = Transform("images/backgrounds/table_open_letter.png", xysize=(1920, 1080))
image bg university_entrance = Transform("images/backgrounds/university_entrance.png", xysize=(1920, 1080))
# Логотипы
image logo prologue = Transform("images/logo/prologue.png", xysize=(1200, 700))
image logo chapter1 = Transform("images/logo/chapter1.png", xysize=(1200, 700))

# --- Объявление персонажей ---
define narr = Character(None, what_color="#ffffff")
default mc_name = "Алекс" 
define mc = Character("[mc_name]", color="#88ccff")
define mc_thought = Character("[mc_name]", what_color="#aaaaaa", what_italic=True, what_size=26)
# ЧИАРА
define chiara = Character("Чиара", color="#42AAFF")
image chiara default2 = "images/characters/chiara_default2.png"
image chiara default1 = "images/characters/chiara_default1.png"
image chiara smile = "images/characters/chiara_smile.png"
image chiara think = "images/characters/chiara_think.png"
image chiara shy1 = "images/characters/chiara_shy1.png"
image chiara shy2 = "images/characters/chiara_shy2.png"
# КАСС
define kass = Character("Касс", color="#FF0000")
image kass default = "images/characters/kass_default.png"
image kass bully = "images/characters/kass_bully.png"
image kass happy = "images/characters/kass_happy.png"

label start:
    # 1. Старт с черного экрана
    scene black with None  
    
    # Музыка начинает играть очень плавно
    play music "audio/music/prologue.mp3" fadein 4.0
    
    # Принудительная пауза, чтобы игрок не проскипал красивый переход
    $ renpy.pause(1.0, hard=True)
    scene bg black_corridor with Dissolve(2.0)
    $ renpy.pause(1.5, hard=True)
    
    narr "Выпускаясь из школы, люди обычно делятся на два типа..."
    narr "Первые уже давно знают, куда поступят, кем станут и сколько будут зарабатывать лет через десять."
    narr "У них всё расписано: университет, работа, успешная жизнь и, желательно, собственная квартира с видом на город."
    narr "Вторые смотрят на заявление о поступлении так, словно им предложили выбрать, какой рукой отрезать себе ногу."
    narr "«Кем ты хочешь стать?»"
    narr "«Куда будешь поступать?»"
    narr "«Ты вообще думал о будущем?»"
    narr "Один неверный выбор — и вот ты уже сорок лет просыпаешься на работу, которую ненавидишь."
    narr "По крайней мере, некоторые искренне в это верят."
    narr "Но точно не он."
    narr "Его имя..."
    
    # Отключаем скип
    $ config.skipping = None
    
    # Запрос имени
    $ mc_name = renpy.input("Его имя...", default="Генри", length=20).strip()
    if not mc_name:
        $ mc_name = "Генри"
        
    narr "[mc_name] Грант никогда не любил строить планы дальше ближайших выходных."
    narr "Не потому, что был уверен в завтрашнем дне. Скорее наоборот: зачем ломать голову над тем, чего ещё даже не произошло?"
    narr "Как-нибудь разберётся."
    narr "Наверное."

    # Переход в коридор дома
    scene bg home_corridor with Dissolve(1.5)
    $ renpy.pause(1.0, hard=True)
    mc "Зевок..."
    
    narr "Лето подходило к концу. Из тех самых трёх месяцев свободы, которые в июне казались бесконечными, остались жалкие крошки."
    narr "За это время [mc_name] успел выспаться, пересмотреть кучу всякой ерунды и отправить документы в такое количество вузов, что к концу уже путал их названия."
    narr "Не то чтобы он плохо учился. Когда хотел, мог даже неплохо соображать."
    narr "Проблема была в том, что хотел он не особенно часто."
    narr "Родители, впрочем, считали такую жизненную позицию катастрофой. Они советовали, убеждали, ругались, снова советовали."
    narr "Каждое семейное обсуждение будущего неизменно заканчивалось примерно одинаково."
    mc_thought "«Тебе нужно определиться». Да понял я. Только от того, что вы спросите ещё раз, ответ не появится."
    narr "[mc_name] остановился возле тумбы, на которой обычно скапливалась почта. Рекламные листовки, какие-то счета, письма, которые никто не спешил открывать…"
    
    # Переход к письмам
    scene bg table_closed with Dissolve(1.5)
    $ renpy.pause(1.0, hard=True)
    mc "Столько мусора..."
    narr "Среди привычных конвертов лежал один, который буквально требовал обратить на себя внимание."
    narr "Плотная бумага, большая печать, аккуратная надпись."
    narr "FLAWED."
    mc "…Чего?"
    narr "FLAWED — Основы гуманитарных наук, инженерного дела и дизайна."
    narr "Звучит как обычное название учебного заведения, пока не узнаешь, что за ним стоит."
    narr "Сильные преподаватели, продуманная программа, престиж, которым здесь, кажется, можно было расплачиваться вместо денег."
    narr "Попасть туда мечтали многие. И большинство ради этого годами сидели над учебниками, собирали портфолио и участвовали во всём, где только можно было получить лишний балл."
    narr "А [mc_name]..."
    narr "Ничего не делал."
    mc "Нет, стоп. Это же не…"
    narr "Он перевернул конверт, проверил адрес, снова посмотрел на печать."
    mc "Может, они ошиблись домом? Или фамилии совпали?"
    # Открытое письмо
    scene bg table_open with Dissolve(1.5)
    $ renpy.pause(1.0, hard=True)
    narr "Внутри лежало официальное приглашение. [mc_name] пробежал глазами по строчкам, затем перечитал ещё раз. Уже медленнее."
    mc_thought "Какого хуя?.. Тут моё имя. Моя фамилия. Всё моё."
    mc "Меня… реально приняли?"
    narr "Он посмотрел на письмо так, будто оно могло в любую секунду передумать."
    mc "Ладно. Допустим. И что теперь?"
    narr "Ответ был очевидным."
    narr "Когда тебе предлагают место в одном из лучших университетов страны, отказываться потому, что ты «не очень-то собирался», - как минимум странно."
    narr "Может, судьба наконец решила определиться за него."
    narr "Вопрос только в том, хорошая ли у судьбы репутация."
    
    # Логотип
    show logo prologue at truecenter with Dissolve(3.0)
    $ renpy.pause(3.0, hard=True) # Жесткая пауза, чтобы игрок посмотрел логотип
    
    hide logo prologue
    scene black with Dissolve(2.5)
    $ renpy.pause(2.0, hard=True)
    
    # Вход в вуз
    stop music fadeout 3.0
    scene bg university_entrance with Dissolve(3.0)
    $ renpy.pause(1.5, hard=True)
    play music "audio/music/letstarthere.mp3" fadein 3.0
    
    narr "Сентябрь подкрался неожиданно. Ещё вчера, казалось, можно было лежать до обеда и делать вид, что взрослая жизнь существует где-то очень далеко."
    narr "А сегодня [mc_name] стоял перед входом в FLAWED с сумкой, чемоданом и весьма сомнительным пониманием того, что делать дальше."
    narr "Вокруг кипела жизнь."
    narr "Студенты тащили вещи, спорили о комнатах, знакомились, обнимались после каникул."
    narr "Кто-то уже жил здесь с лета, остальные, как и [mc_name], только заселялись."
    mc_thought "Ну… выглядит дорого. Даже слишком. Надеюсь, за воздух платить не придётся."
    narr "Грант в очередной раз достал телефон, сверился с адресом и поднял взгляд на главный вход."
    mc_thought "Так. Я на месте. Осталось понять, куда идти."
    chiara "Хей! Я здесь! Привет!"
    narr "Голос раздался совсем рядом. [mc_name] успел только повернуть голову, как перед ним уже оказалась миловидная девушка."

    show chiara default2:
        zoom 0.70
        xalign 0.50
        yalign 1.00
        xoffset 0
        yoffset 120
    with dissolve
    show chiara default1:
        zoom 0.70
        xalign 0.50
        yalign 1.00
        xoffset 0
        yoffset 120
    with dissolve
    chiara "Привет-привет! Ты же новенький, да? Только приехал?"
    mc "Э-э…"
    show chiara default2
    chiara "Извини, я, кажется, слишком резко подлетела. Просто вас, новеньких, обычно сразу видно."
    show chiara default1
    chiara "Ходите туда-сюда... и все такое."
    narr "Девушка улыбнулась так искренне, что сразу стало немного неловко стоять перед ней с лицом человека, которому только что задали сложный вопрос на экзамене."

    menu:

        "Привет, да, я только приехал!":
            jump chiara_choice_1

        "Отъебись.":
            jump chiara_choice_2

        "Прости, ты, наверное, ошиблась.":
            jump chiara_choice_3

label chiara_choice_2:

    narr "Смело. Очень смело."
    narr "Но давай не будем начинать первый день в новом университете с того, что пошлём единственного человека, который предложил нам помощь."
    narr "Представим... что [mc_name] ответил «Привет, да, я только приехал!» и забудем об этом, окей?"

    jump chiara_choice_1
label chiara_choice_3:

    show chiara think:
        zoom 0.60
        xalign 0.50
        yalign 1.00
        xoffset 0
        yoffset 120
    with dissolve
    chiara "Правда что-ли? Ты так удивленно разглядывал всё вокруг, я уж подумала..."
    mc "Я пошутил, не парься."
    show chiara smile
    chiara "Очень смешно... Я уже решила, что пристаю к какому-нибудь преподавателю первого курса."
    mc "Ты всех преподавателей встречаешь с криком «хей»?"
    show chiara shy2
    chiara "Нет! То есть… надеюсь, нет. Слушай, не пугай меня так."
    show chiara smile
    narr "Она рассмеялась, а [mc_name] невольно улыбнулся в ответ."
    jump chiara_choice_1

# ПЕРВЫЙ ВАРИАНТ: ОСНОВНАЯ СЮЖЕТНАЯ ЛИНИЯ
label chiara_choice_1:
    show chiara default1:
        zoom 0.70
        xalign 0.50
        yalign 1.00
        xoffset 0
        yoffset 120
    with dissolve
    mc "Настолько заметно, что я только приехал?"
    show chiara default2
    chiara "Ну, чемодан немного выдаёт."
    show chiara think
    chiara "Хотя знаешь, один парень вчера полчаса ходил с чемоданом по кругу и уверял, что просто гуляет."
    mc "Может, это был его способ познакомиться с территорией."
    show chiara smile
    chiara "Если так, то он теперь знает входную лестницу лучше всех в университете."

    # КОНЕЦ ВЫБОРА
    show chiara default1:
        zoom 0.70
        xalign 0.50
        yalign 1.00
        xoffset 0
        yoffset 120
    with dissolve
    chiara "Ладно, раз ты только приехал, давай помогу. Я сегодня с заселением разбираюсь."
    chiara "Ну, не одна, конечно, просто вызвалась помочь. А потом ещё немножко помочь. И ещё…"
    mc "То есть теперь всё держится на тебе?"
    show chiara default2
    chiara "Нет! Конечно нет. Просто… ну, если я уже здесь, почему бы не помочь, правда?"
    narr "Судя по лёгкой растерянности во взгляде, это «почему бы» прозвучало сегодня далеко не впервые."
    chiara "Так-с. Мне нужно сверить тебя со списком. Как тебя зовут?"
    mc "[mc_name] Грант. Поступил по приглашению."
    show chiara default1
    chiara "По приглашению? Ого!"
    mc "Это хорошо или я что-то нарушил?"
    show chiara smile
    chiara "Нет-нет, что ты! Это очень круто."
    chiara "Сюда многие годами пытаются попасть, а приглашение просто так не присылают. Значит, ты чем-то их заинтересовал."
    mc_thought "Хотелось бы знать чем."
    mc "Возможно, у них очень специфическое чувство юмора."
    show chiara default2
    chiara "Или ты просто скромничаешь. Такое тоже бывает, знаешь ли."
    mc "Да я бы не сказал, что это моя главная проблема."
    chiara "Вот как? Ну, мы с тобой ещё успеем выяснить, в чем твоя главная проблема. Но сначала - заселение."
    narr "Чиара достала стопку бумажек из сумки и начала искать в них нужную фамилию."
    show chiara default2
    chiara "Кстати, я ведь даже не представилась! Чиара Росси."
    stop music fadeout 3
    play music "audio/music/Chiara.mp3" fadein 3.0
    mc "Приятно познакомиться, Чиара."
    chiara "Взаимно! И можешь обращаться ко мне, если что-то понадобится."
    chiara "Хотя… погоди, я не обещаю знать вообще всё. Но могу попробовать найти того, кто знает."
    mc "У тебя прямо служба поддержки с физической формой."
    show chiara smile
    chiara "Ха! Звучит даже солидно. Надо будет так и представляться."
    narr "Чиара вновь уткнулась в список. Время от времени она шевелила губами, беззвучно повторяя фамилии, и хмурилась, когда нужная строка никак не находилась."
    narr "Пока она занималась поисками, [mc_name] наконец смог рассмотреть новую знакомую внимательнее."
    narr "Пышные каштановые волосы, красивые голубые глаза, открытая улыбка…"
    mc_thought "Ну, допустим, знакомство с университетом началось не так уж и плохо."
    show chiara think
    chiara "Грант… Грант… Так, это не то… Странно."
    mc "Что-то не так?"
    chiara "А? Нет, я просто… Сейчас ещё раз проверю. Тут списки немного неудобные."
    show chiara default1
    narr "Улыбка у неё осталась, только стала чуть более натянутой. [mc_name] уже собирался спросить, в чём дело, как вдруг..."
    stop music fadeout 0.1
    play music "audio/music/skr.mp3" noloop
    kass "Красотка, не там ты парня себе ищешь!"
    play music "audio/music/kassandra.mp3" fadein 3.0
    narr "Чиара резко подняла голову. К ним направлялась ещё одна девушка — с таким уверенным видом, будто всё происходящее вокруг было её личным развлечением."
    # Чиара появляется слева
    show chiara default2:
        zoom 0.70
        xcenter 0.20
        yalign 1.0
        yoffset 120
    with dissolve
    # Чиара перемещается вправо
    show chiara default2:
        zoom 0.70
        xcenter 0.20
        yalign 1.0
        yoffset 120
        ease 1.0 xcenter 0.75
    pause 0.5
    # Касс появляется слева
    show kass default:
        zoom 0.70
        xcenter 0.20
        yalign 1.0
        yoffset 120
    with dissolve
    kass "Серьёзно, Росси? Прямо у входа? Ты хоть дашь человеку до комнаты дойти?"
    show chiara shy1
    show kass default
    with dissolve
    chiara "Касс! Я вообще-то помогаю с заселением!"
    kass "Ага. Конечно."
    show kass bully
    kass "Поэтому уже минут десять стоишь с одним парнем и улыбаешься ему, как ненормальная."
    chiara "Мы не десять минут разговариваем!"
    kass "О, прости. Девять с половиной."
    chiara "Какая тебе вообще разница?"
    show kass default
    narr "Касс резко повернулась в сторону [mc_name] и оценивающе быстро окинула его взглядом."
    show chiara shy2
    kass "Ты бы хоть слово сказал."
    kass "Ну? Зовут-то тебя как, новенький?"
    mc "Меня..."
    kass "Грант какой-то там, да? Краем уха услышала. Ладно, запомню, если не разочаруешь."
    mc "Вообще-то у «какого-то там» есть имя."
    kass "Вапсета... И характер, оказывается у тебя тоже есть. Уже лучше."
    narr "Девушка еще раз окинула Гранта оценивающим взглядом."
    kass "Касс. Для особо любопытных - Кассандра Руа. Но если вздумаешь звать меня полным именем, мы с тобой не подружимся."
    mc "Учту. У вас тут у всех такое тёплое приветствие?"
    kass "Нет. Тебе ещё повезло."
    chiara "Касс, можно ты хотя бы сегодня будешь нормально общаться с людьми?"
    show kass bully
    kass "Я нормально общаюсь. Не нравится - не слушай."
    mc "Мне кажется, у нас с тобой разные представления о нормальном общении."
    kass "Ещё один умник. Прекрасно."
    narr "Несмотря на колкость, Касс едва заметно усмехнулась."
    narr "Кажется, ответ ей понравился больше, чем она собиралась показывать."
    show kass default
    show chiara shy2
    kass "Ладно, Росси, я вообще-то тебя искала."
    kass "Ты опять согласилась работать за троих?"
    chiara "Не за троих! Просто у ребят сегодня много дел, а я всё равно была свободна…"
    kass "А вчера ты была свободна помочь с коробками. А позавчера - с расписанием."
    kass "Тебе слово «нет» знакомо?"
    chiara "Знакомо!"
    kass "Произнеси."
    chiara "Касс!"
    kass "Почти получилось."
    mc "Не хочу вмешиваться, но, по-моему, она сейчас очень вежливо его произнесла."
    kass "Тебя забыли спросить, Грант."
    narr "Касс закатила глаза и отступила на полшага. Потом снова посмотрела на Гранта."
    kass "Хотя знаешь… может, ты и не самый плохой вариант."
    kass "По крайней мере, не совсем безнадёжный."
    show chiara shy1
    chiara "Вариант чего?!"
    kass "Ой, да не красней ты так. Я же шучу."
    mc "Я, если честно, тоже хотел бы уточнить."
    kass "Расслабься. Для начала научись отвечать без пауз, а то мямля какой-то."
    show kass bully
    show chiara shy2
    kass "Ну ты и мямля!"
    mc "Это ты мне даже договорить не даёшь."
    kass "Вот и тренируйся. В жизни пригодится."
    narr "Касс уже развернулась, собираясь уходить, но на секунду задержалась."
    kass "Заканчивай уже, Росси, мелкие и сами разберутся."
    show kass default:
        zoom 0.70
        xcenter 0.20
        yalign 1.0
        yoffset 120
        ease 1.5 xcenter -0.75
    narr "С этими словами Касс ушла, оставив после себя странную смесь неловкости, раздражения и ощущения, что тебя только что проверили на прочность."
    # Ждём завершения анимации
    $ renpy.pause(1.0, hard=True)
    # Убираем спрайт Касс
    hide kass
    # Чиара плавно возвращается в центр
    show chiara shy1:
        zoom 0.70
        xcenter 0.75
        yalign 1.0
        yoffset 120
        ease 1.0 xcenter 0.50
    $ renpy.pause(1.0, hard=True)
    chiara "Прости, пожалуйста. Она иногда вообще не думает, что говорит."
    stop music fadeout 4
    play music "audio/music/Chiara.mp3" fadein 3.0
    mc "Иногда?"
    chiara "Ладно… Часто. Но она не такая ужасная, какой кажется!"
    mc "Смелое заявление после всего, что я сейчас услышал."
    show chiara shy2
    chiara "Я серьёзно. Мы с ней в одной комнате живём."
    chiara "У неё характер сложный, но… когда правда нужна помощь, она не проходит мимо."
    mc "Просто сначала морально уничтожает нуждающегося?"
    chiara "Ну…"
    narr "Чиара задумалась, словно пыталась найти убедительное опровержение. Судя по выражению лица, оно пока не находилось."
    show chiara smile
    chiara "Не всегда!"
    mc "Ладно, убедила. Почти."
    show chiara default2
    chiara "Спасибо, что не обиделся. Правда."
    mc_thought "Класс. Я даже заселиться не успел, а уже познакомился с местной грозой первокурсников. Интересно, здесь все такие?"
    mc "Забей. Я и похуже людей встречал. Зато скучно точно не будет."
    chiara "Это уж точно…"
    narr "Чиара тихо засмеялась, но стоило ей снова взглянуть на бумаги, как улыбка понемногу исчезла."
    show chiara think
    chiara "Слушай, [mc_name]… Тут есть одна маленькая странность."
    mc "Насколько маленькая?"
    chiara "Ну… Я не могу найти тебя в списке новых студентов."
    mc "В смысле - не можешь найти?"
    chiara "В самом обычном. Тут должны быть все, кто заселяется в этом году, а твоей фамилии нет."
    chiara "Может, списки ещё не обновили? Такое бывает."
    chiara "Наверное."
    mc "«Наверное» прозвучало не очень уверенно."
    show chiara default1
    chiara "Да, я знаю. Извини. Я не хотела тебя пугать."
    mc "Поздно, я уже мысленно еду домой."
    chiara "Без паники! Это ещё ничего не значит. У тебя ведь есть приглашение?"
    mc "Есть."
    chiara "Можешь показать? Я проверю, совпадают ли данные."
    narr "[mc_name] полез в сумку и достал письмо. За последние недели он столько раз его перечитывал, что мог бы, пожалуй, сдать по нему отдельный экзамен."
    mc_thought "Ну вот. Не успел приехать, а меня уже проверяют. Только бы это не оказалось какой-нибудь идиотской ошибкой..."
    show chiara think
    chiara "Так… имя совпадает, фамилия тоже. Печать на месте, подписи… Вроде всё правильно."
    mc "Вот. Я же говорил."
    chiara "Только..."
    mc "Что там?"
    chiara "Тут стоит дата отправки за прошлый год..."
    narr "Девушка повернула приглашение к Гранту и указала на строчку внизу."
    mc "Подожди. В каком смысле - за прошлый?"
    chiara "В прямом. По документу выходит, что приглашение отправили ещё тогда."
    chiara "А сейчас уже новый набор."
    mc "Чего? Да я его две недели назад получил! Оно пришло вот недавно!"
    chiara "Уверен?"
    mc "Чиара, поверь, если бы меня пригласили в FLAWED год назад, я бы это запомнил."
    chiara "Да, прости, глупый вопрос…"
    mc "То есть меня могут просто не принять?"
    show chiara default1
    narr "Чиара замолчала."
    narr "Было видно, что ей очень хочется немедленно сказать «нет, конечно», но даже она понимала, что обещать такое сейчас нельзя."
    chiara "Я не знаю. Не хочу тебя обманывать."
    chiara "Но это ведь странно, правда?"
    show chiara think
    chiara "Если письмо действительно пришло совсем недавно, нужно выяснить, почему в нём старая дата."
    mc "И почему меня нет в списках."
    show chiara default2
    chiara "Да. И это тоже."
    narr "Некоторое время они смотрели на письмо."
    narr "Вокруг продолжали смеяться и разговаривать студенты, кто-то громко позвал друга, возле дверей прокатили чемодан."
    narr "Мир явно не собирался останавливаться из-за чужих проблем с документами."
    mc_thought "На самом деле мне очень приятно, что Чиара так заботиться обо мне, ей же по ровному счету должно быть все равно..."
    mc "Слушай, я ведь даже не знаю, куда мне теперь идти. Стоять тут до вечера?"
    show chiara default1
    chiara "Нет! То есть… не надо, конечно."
    chiara "Давай так: я провожу тебя в свободную комнату. Пока хотя бы оставишь вещи, а я попробую разобраться со списками и приглашением."
    mc "А тебя за это не накажут? Вдруг окажется, что я вообще тут лишний."
    chiara "Не накажут. Надеюсь."
    mc "Обнадёживает."
    show chiara smile
    chiara "Эй, ну я стараюсь! Если сама ничего не выясню, пойдём к администрации."
    chiara "В крайнем случае — к директору. Главное, не делай выводов раньше времени, хорошо?"
    mc "Ты всегда так берёшься решать чужие проблемы?"
    show chiara shy2
    chiara "Не всегда…"
    narr "Чиара отвела взгляд, а потом негромко добавила:"
    chiara "Просто не хочется бросать человека, когда он только приехал и понятия не имеет, что делать."
    chiara "Ты же не виноват, что у них что-то перепуталось."
    mc "Ну, мы ещё не выяснили, кто виноват."
    show chiara smile
    chiara "Вот именно! Так что сначала выясним, а потом будем паниковать."
    mc "Договорились. Хотя я уже немного начал."
    chiara "Тогда тебе досталась очень удачная сопровождающая. Я могу паниковать за двоих."
    mc "Звучит как сомнительное преимущество."
    chiara "Зато честно!"
    mc "Зато честно."
    narr "[mc_name] не удержался от улыбки. Чиара, кажется, и сама была не уверена, что всё закончится хорошо."
    narr "Но почему-то после разговора с ней стало чуть спокойнее."
    stop music fadeout 3.0
    play music "audio/music/letstarthere.mp3" fadein 3.0
    show chiara default1
    chiara "Ну что, пойдём?"
    chiara "А то ты так и будешь стоять у входа с чемоданом."
    mc "А вдруг это моя новая специальность? Стоять у входа и красиво выглядеть."
    chiara "Хм… Тогда у меня плохие новости: у нас тут ещё и учиться приходится."
    mc "Задача... Надо было внимательнее читать приглашение."
    show chiara smile
    chiara "Пошли уже!"
    narr "Девушка махнула рукой в сторону дверей и первой направилась внутрь. [mc_name] подхватил чемодан и двинулся следом."
    hide chiara
    narr "При всём своём великолепии FLAWED оказался не совсем тем идеальным местом, каким его представляли абитуриенты."
    narr "Здесь, как и в любом университете, существовали странные правила, путаница с бумагами, люди, которые вечно ничего не знали, и люди, которые делали вид, будто знают всё."
    narr "Просто за красивыми стенами недостатки замечались не сразу."
    narr "Грант пока не понимал, что именно случилось с его приглашением."
    narr "Ошибка?"
    narr "Чья-то невнимательность?"
    narr "Неудачное совпадение?"
    narr "Очень хотелось верить, что ответ окажется скучным и простым."
    narr "Но если бы всё действительно было так просто, рассказать было бы особо нечего."
    narr "Впереди его ждали новые знакомства, неожиданные решения, неприятности, временами даже опасности…"
    narr "И девушки, которые явно не собирались делать его жизнь спокойнее."
    show logo chapter1 at truecenter with Dissolve(3.0)
    $ renpy.pause(3.0, hard=True)
    
    hide logo chapter1
    scene black with Dissolve(2.5)
    $ renpy.pause(2.0, hard=True)

    return